# Top-level .env example. Copy to .env (root), web/.env.local (frontend), and use Modal secrets for inference-api.

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Modal-deployed inference API
INFERENCE_API_URL=https://YOUR-USER--neuropulse-inference-fastapi-app.modal.run
INFERENCE_API_KEY=generate-with-openssl-rand-hex-32

# Modal-deployed A/B engine
AB_ENGINE_URL=https://YOUR-USER--neuropulse-ab-fastapi-app.modal.run

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_ENTRY=price_...

# Resend (email)
RESEND_API_KEY=re_...

# Sentry (optional)
SENTRY_DSN=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
